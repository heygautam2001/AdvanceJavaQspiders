	@DeleteMapping("/product/id")
	public ResponseEntity<ResponseStructure<String>> deleteProductById(@RequestParam Integer id) {

		ResponseStructure<String> rs = new ResponseStructure<String>();

		boolean delete = prodService.deleteProductById(id);
		if (delete) {

			rs.setStatus(HttpStatus.OK.value());
			rs.setMessage("Product is deleted");
			rs.setData(null);
			return new ResponseEntity<ResponseStructure<String>>(rs, HttpStatus.OK);
		} else {

			rs.setStatus(HttpStatus.INTERNAL_SERVER_ERROR.value());
			rs.setMessage("Error in deleting product");
			rs.setData("Error Delete");
			return new ResponseEntity<ResponseStructure<String>>(rs, HttpStatus.INTERNAL_SERVER_ERROR);
		}

	}

	@DeleteMapping("/product")
	public String deleteAllProducts() {
		if (prodService.deleteAllProducts()) {
