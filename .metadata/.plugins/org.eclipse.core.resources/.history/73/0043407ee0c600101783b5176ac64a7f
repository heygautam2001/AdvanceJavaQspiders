	@PostMapping("/product")
	public ResponseEntity<ResponseStructure<String>> addProduct(@RequestBody Product prod) {

		ResponseStructure<String> rs = new ResponseStructure<String>();

		boolean res = prodService.addProduct(prod);

		if (res) {
			rs.setStatus(HttpStatus.OK.value());
			rs.setMessage("product added successfully");
			rs.setData("product added");
			return new ResponseEntity<ResponseStructure<String>>(rs, HttpStatus.OK);

		} else {

			rs.setStatus(HttpStatus.INTERNAL_SERVER_ERROR.value());
			rs.setMessage("Failed to add product");
			rs.setData("Failed to add product");
			return new ResponseEntity<ResponseStructure<String>>(rs, HttpStatus.INTERNAL_SERVER_ERROR);

		}

	}

