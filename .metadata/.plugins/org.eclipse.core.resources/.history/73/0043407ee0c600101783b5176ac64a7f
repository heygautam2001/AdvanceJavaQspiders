	@GetMapping("/product/{id}")
	public ResponseEntity<ResponseStructure<Product>> findProductById(@PathVariable Integer id) {

		ResponseStructure<Product> rs = new ResponseStructure<Product>();
		Product prod = prodService.findProductById(id);

		if (prod != null) {
			rs.setStatus(HttpStatus.FOUND.value());
			rs.setMessage("Data Found");
			rs.setData(prod);

			HttpHeaders hh = new HttpHeaders();
			hh.set("msg", "Data found");

			return new ResponseEntity<ResponseStructure<Product>>(rs, hh, HttpStatus.FOUND);

		} else {

			rs.setStatus(HttpStatus.NOT_FOUND.value());
			rs.setMessage("Data Not Found");
			rs.setData(null);

			HttpHeaders hh = new HttpHeaders();
			hh.set("msg", "Data not found");

			return new ResponseEntity<ResponseStructure<Product>>(rs, hh, HttpStatus.NOT_FOUND);

		}

	}

