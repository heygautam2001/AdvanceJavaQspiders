	static EntityManagerFactory emf = Persistence.createEntityManagerFactory("hibernate01");

	@Override
	public boolean addProduct() {
		
		EntityManager em = emf.createEntityManager();
		EntityTransaction et = em.getTransaction();
		Scanner sc = new Scanner(System.in);
		
		Product p = new Product();
		
		System.out.println("Enter the Id :  ");
		int id = sc.nextInt();
		p.setId(id);
		sc.nextLine();
		
		System.out.println("Enter the product name");
		p.setName(sc.nextLine());
		
		System.out.println("Enter the poroduct price");
		p.setPrice(sc.nextDouble());
		sc.nextLine();
		
		System.out.println("Enter the product rating : ");
		p.setRating(sc.nextDouble());
		sc.nextLine();
		
		System.out.println("Enter the type : ");
		p.setType(sc.nextLine());
		
		try {
			et.begin();
			em.persist(p);   // ✅ Save the Product entity
			et.commit();
			System.out.println("✅ Product saved successfully!");
			return true;
		} catch (Exception e) {
			if (et.isActive()) et.rollback();
			e.printStackTrace();
			return false;
		} finally {
			em.close();
		}

	}

