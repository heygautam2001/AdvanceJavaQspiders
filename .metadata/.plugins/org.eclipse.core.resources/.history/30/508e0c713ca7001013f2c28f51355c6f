	@Override
	public boolean updateProdudct(int id) {
		EntityManager em = emf.createEntityManager();// Step: statement/prepare statement.
		EntityTransaction et = em.getTransaction();
		System.out.println(emf);
		Scanner sc = new Scanner(System.in);

		System.out.println("Enter the product name");
		String name = sc.nextLine();

		System.out.println("Enter the product price : ");
		double price = sc.nextDouble();
		sc.nextLine();

		System.out.println("Enter the rating of the product");
		double rating = sc.nextDouble();
		sc.nextLine();

		System.out.println("Enter type of product");
		String type = sc.nextLine();
		

        //2 way :  finding and updating

		Product p = em.find(Product.class, id);

		p.setName(name);
		p.setPrice(price);
		p.setRating(rating);
		p.setType(type);

		et.begin();
		em.merge(p);
		et.commit();

		return true;
	}

	@Override
	public boolean removeProduct(int id) {
		EntityManager em = emf.createEntityManager();// Step: statement/prepare statement.
		EntityTransaction et = em.getTransaction();
		System.out.println(emf);
		
		// finding the object and then  remove
		
		Product s = em.find(Product.class,id);
		
		et.begin();
		em.remove(s);
		et.commit();
		
		return true;
	}

