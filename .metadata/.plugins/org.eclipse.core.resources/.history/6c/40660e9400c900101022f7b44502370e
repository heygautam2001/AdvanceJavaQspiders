package edu.qs.controller;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class ProductController {
	@Autowired
	ProductRepository prodRepo;

	@PostMapping("/product")
	public String addProduct(@RequestBody Product prod) {

		Product newProd = prodRepo.save(prod);

		if (newProd.getId() != null) {
			return "Product added successfully";

		} else {
			return "failed to add product";
		}

	}

	@PostMapping("/products")
	public String addMultipleProduct(@RequestBody List<Product> prods) {
		prodRepo.saveAll(prods);

		return "Product saved successfully";
	}

	@GetMapping("/product")
	public Product findProductById(@RequestParam int id) {
		Optional<Product> opt = prodRepo.findById(id);

		if (opt.isPresent()) {
			return opt.get();
		} else {
			return null;
		}
	}
	
	@GetMapping("/products")
	public List<Product> findAllProduct(){
		return prodRepo.findAll();
		
		
	}
	
	@DeleteMapping("/product/{id}")
	public String deleteProductById(@PathVariable int id) {
		prodRepo.deleteById(id);
		
		
		return "Product deleted successfully";
	}
	@DeleteMapping("/products")
	public String deleteAllProducts() {
		prodRepo.deleteAll();
		return "all products deleted successfully";
	}
	@PutMapping("/product")
	public String updateProduct(@RequestBody Product prod) {
		prodRepo.save(prod);
		return "product added successfully";
	}
	
	

}
