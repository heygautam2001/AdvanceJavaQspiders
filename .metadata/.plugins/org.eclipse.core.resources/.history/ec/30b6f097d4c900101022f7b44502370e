package edu.qs.controller;

import java.util.List;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;

public interface ProductRepository extends JpaRepository<Product, Integer>{
	// 1. Automatic custom query generation
	// Pattern findBy , findBy And , findBy Between
	
     
	public abstract List<Product> findByType(String type);
	
	public Product findByNameAndPrice(String name,Double price);
	
	public List<Product> findByPriceBetween(Double p1, Double p2);
	
	//task 1 - find by name or Price
	
	//task 2 - greater than price
	
	
	// ========================================================================================================//
	
	@Query("select p from p")
	public List<Product> getAllProductData();
	
	@Query("select p.name from Product p")
	public List<String> getAllProductNames();
	
	@Query("select p.name , p.price from Product p")
	public List<Object[]> getNamesAndPrice();
	
	
	@Query("select p from Product p where p.name = ?1 , p.price = ?2")
	public Product getProductByNamePrice(String name , Double price);
	
	@Query("select p from Product p where p.rating between :r1 and :r2")
	public List<Product> getProductBetweenRating(Double r1 , Double r2);
	
}
