   @PutMapping("/product")
   public String updateProduct( @RequestBody Product prod) {
		if(prodService.updateProduct(prod)) {
			return "Product updated successfuly";
		}
		return "failed to update product";
	   
   }
	
	@PatchMapping("/product")
	   public String partialUpdate( @RequestBody Product prod) {
			if(prodService.partialUpdate(prod)) {
				return "Product updated successfuly";
			}
			return "failed to update product";
		   
	   }
	
	@DeleteMapping("/product/id")
	public String deleteProductById(@RequestParam int id) {
		if(prodService.deleteProductById(id)) {
			return "Product deleted successfully";
		}else {
			return "failed to remove product";
		}
		
	}
	
	@DeleteMapping("/product")
	public String deleteAllProducts() {
		if(prodService.deleteAllProducts()) {
			return "deletion successfull";
		}
		return "deletion unsuccessfull";
	}
	
	@PostMapping("/product")
	public String addProduct(@RequestBody Product prod) {
		if(prodService.addProduct(prod)) {
			return "product added successsfully";
			
			
		}
		return "Error in adding products";
	}
	
	@GetMapping("/product/{id}")
	public ResponseStructure<Product> findProductByID(@PathVariable Integer id){
		ResponseStructure<Product> rs = new ResponseStructure<Product>();
		
		Product prod = prodService.findProductById(id);
		
		if(prod != null) {
			rs.setStatus(HttpStatus.FOUND.value());
			rs.setMessage("Data Found");
			rs.setData(prod);
			return rs;
		}
		
			rs.setStatus(HttpStatus.NOT_FOUND.value());
			rs.setMessage("Data  not Found");
			rs.setData(null);
			return rs;
		
	}
	
