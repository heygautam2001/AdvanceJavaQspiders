<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
     <%@page import="product_crud_task.Product" %>
    <%@page import="java.util.List" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
  <a href = "add_product.jsp">Add Products</a>
  <hr>
  
  <%
  
  List <Product> prods = (List<Product>)request.getAttribute("products");
  
  if(prods != null){
  
  %>
  
  <table border = "1">
      <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Price</th>
      <th>Type</th>
      <th>Image</th>
      </tr>
      
      <%
      for(Product p : prods){
      %>
       
       <tr>
       <td><%= p.getId() %></td>
       <td><%= p.getName() %></td>
       <td><%= p.getPrice() %></td>
       <td><%= p.getType() %></td>
       <td> <img alt="image not found" src="prod_image?id=<%=p.getId() %>" height="50"> </td>
       </tr>
      
      <% } %>
      
   </table>
   
   <% }
   else{
	   out.print("<>h2 No products addes</h2>");
   }
   %>
</body>
</html>